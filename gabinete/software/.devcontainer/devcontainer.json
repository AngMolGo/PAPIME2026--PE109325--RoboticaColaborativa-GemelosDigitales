{
  "name": "devc_pe115326",
  "dockerComposeFile": [
    "../compose.yaml",       // Tu archivo maestro
    "./compose.dev.yaml"    // El parche para desarrollo
  ],
  "service": "pe115326_app",
  "workspaceFolder": "/root/ros2_ws",
  "runServices": ["pe115326_app"],
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash /root/.setup_scripts/postcreate.bash",
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "idf.gitPath": "/usr/bin/git"
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python"
      ]
    }
  }
}